    "m_ObjectId": "3dd5641afb384b99986b1e509a34948b",
    "m_Title": "Texture Requirements",
    "m_Content": "The sampler fo the texture now requires that your textures you feed it have a alpha instead of black the gets clipped out. THe number for the AlphaClippingThreshold should be set anywhere from 0 to 0.8 for best results. \n ",
    "m_TextSize": 0,
    "m_Theme": 0,
