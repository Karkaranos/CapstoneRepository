  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<b><align=center><size=150%>Production</b></align></size>\n\nLead
    Producer - Elda Osmani\n\nCreative Director - Jaxson Green\n\nAssociate Producer
    - William Dietert\n\n\n\n<b><align=center><size=150%>Art</b></align></size>\n\nArt
    Lead - Lindsey Dyer\n\nCharacter Artist - Drew Mulacek\n\nCharacter Animator
    - Drew Mulacek\n\nAnimation Programmer - Aidan Ratcliffe\n\nConcept Artist -
    Lindsey Dyer\n                   Drew Mulacek\n\nCutscene Animator - Jaxson Green\n\nCutscene
    Illustrator - Lindsey Dyer\n                       Drew Mulacek\n\nEnvironment
    Artist - Lindsey Dyer\n\nProp Artist - Joel Graber\n\nVFX & Shader Programming
    - Jakub Gorski\n\nVFX Artist - Mary Larsen\n              John Forjan\n\n3D Modeler
    & Animator - Joel Graber\n\n\n\n<b><align=center><size=150%>Design</b></align></size>\n\nDesign
    Lead - Char O'Shaughnessy\n\nCombat Designer - Caitlin Immer\n\nEnemy Designer
    - Ryan Perez\n\nLevel Designer - Marta Tsap\n                      Raymond Knapp\n                  
    Caitlin Immer\n\nMechanics Designer - Char O'Shaughnessy\n\nNarrative Designer
    - Raymond Knapp\n\nSpells Systems Designer - Gabriel Rodriguez\n\nQA - Char O'Shaughnessy\nCaitlin
    Immer\n\n\n\n<b><align=center><size=150%>Programming</b></align></size>\n\nProgramming
    Lead - Cade Naylor\n\nAssistant Programming Lead - Brad Dixon\n\nCombat Programmer
    - Clare Grady\n\nEnemy State Machine Designer & Programmer - Clare Grady\n\nMechanics
    Programmer - Jay Embry\n\nSystems Programmer - Brad Dixon\n                        
    Tyler Hayes\n                             Tyler Bouchard\n                         
    Clare Grady\n                           Cade Naylor\n\nTools Programmer - Cade
    Naylor\n\n\n\n<b><align=center><size=150%>Music & Sound</b></align></size>\n\nMusic
    Composer - Blayne Pummel\n\nSound Designer - Gabriel Holmes\n\nAudio Engine -
    FMOD Studio by Firelight Technologies Pty Ltd.\n\n\n\n<b><align=center><size=150%>User
    Experience</b></align></size>\n\nUI/UX Director - Elda Osmani\n\nUI/UX Artist
    - Madalyn Yacoub\n\nUI/UX Designer - Gabe Rodriguez\n\nUI/UX Programmer - Tyler
    Bouchard\n\n\n\n<b><align=center><size=150%>Voice Acting</b></align></size>\n\nCasting
    & Voice Director - William Dietert\n\nVoice Actor - Kiaundria Blake Knight\n\n\n\n<b><align=center><size=150%>Marketing
    & Advertising</b></align></size>\n\nMarketing Director - Lauren Duell\n\n\n\n\n\n<b><align=center><size=150%>Thank
    you for Playing</b></align></size>\n\n\n\n\n\n\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 1de83ee68a7a38c4380d9db05da0957a, type: 2}
